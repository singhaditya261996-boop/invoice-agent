# Copy to .env (gitignored) and fill in what you need.

# "demo" (replay recorded model responses), "live" (real API calls), "offline" (rules only, no model)
INVOICE_AGENT_MODE=demo

# Demo mode replays data/fixtures/llm_responses.json, which were recorded from one provider and
# model. These must name that provider and model for the replay to match.
INVOICE_AGENT_PROVIDER=google
INVOICE_AGENT_MODEL=gemini-3-flash-preview

# Live mode only. Claude is the default provider; Gemini needs: pip install -e ".[google]"
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
